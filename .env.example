# Másold le .env néven (cp .env.example .env), töltsd ki, majd: chmod 600 .env
# A .env a .gitignore-ban van, sosem kerül a repóba.

# Gmail esetén: smtp.gmail.com, 587-es port, STARTTLS, és egy alkalmazásjelszó
# (Google-fiók > Biztonság > Kétlépcsős azonosítás > Alkalmazásjelszavak).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pelda@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=pelda@gmail.com
MAIL_TO=pelda@gmail.com
